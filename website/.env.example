# Spindle Cloud — local / production env

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
NEXT_PUBLIC_BASE_PATH=

# ── Stripe (so you receive real money) ──────────────────────────
# Secret key + Price IDs → /api/checkout (needs Vercel or similar)
STRIPE_SECRET_KEY=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_SCALE=
# Set to 1 after enabling ACH / US bank in Stripe Dashboard
STRIPE_ENABLE_ACH=0
# Webhook signing secret from Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# Payment Links — work even on static GitHub Pages
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUILDER=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SCALE=

# ── Spindle Agent (optional GPT) ────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase / GitHub Pages static export (no API routes):
# SPINDLE_STATIC=1 npm run build
