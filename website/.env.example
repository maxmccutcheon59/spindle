# Spindle Cloud — local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
NEXT_PUBLIC_BASE_PATH=

# Stripe Payment Links (optional — demo checkout without these)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUILDER=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SCALE=

# Spindle Agent — set for GPT-backed answers (otherwise local Spindle brain)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase static export (no /api/agent): SPINDLE_STATIC=1 npm run build
